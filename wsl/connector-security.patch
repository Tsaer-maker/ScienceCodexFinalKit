+def _read_finalkit_private(fd_env: str, fallback_env: str) -> str:
+    """Read a small controller value from an inherited descriptor."""
+    raw_fd = os.environ.pop(fd_env, "")
+    if raw_fd:
+        try:
+            fd = int(raw_fd)
+            with os.fdopen(fd, "r", encoding="utf-8") as handle:
+                value = handle.read(4097)
+            if len(value) > 4096:
+                raise ValueError("private controller value is too large")
+            return value.strip()
+        except (OSError, TypeError, ValueError):
+            return ""
+    return os.environ.pop(fallback_env, "")
+
+
