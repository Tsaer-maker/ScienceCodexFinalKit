+def _refresh_codex_backend(backend: dict) -> bool:
+    """Force one shared-cache refresh after an unexpected backend 401."""
+    current = codex_auth_store.load()
+    refreshed = codex_auth_store.refresh(current)
+    token = refreshed.get("access_token")
+    if not token or (
+        token == current.get("access_token")
+        and refreshed.get("refresh_token") == current.get("refresh_token")
+    ):
+        return False
+    backend["auth_header"] = f"Bearer {token}"
+    backend["account_id"] = (
+        refreshed.get("chatgpt_account_id")
+        or _account_id_from_id_token(refreshed.get("id_token", ""))
+    )
+    return True
