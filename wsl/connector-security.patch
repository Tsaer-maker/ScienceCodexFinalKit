+@app.middleware("http")
+async def finalkit_control_middleware(request: Request, call_next):
+    """Keep browser-facing management routes private to fkctl."""
+    path = request.url.path
+    protected = path in CONTROL_EXACT_PATHS or path.startswith(CONTROL_PREFIXES)
+    if protected:
+        supplied = request.headers.get("X-FinalKit-Control", "")
+        if not FINALKIT_CONTROL_TOKEN or not hmac.compare_digest(
+            supplied, FINALKIT_CONTROL_TOKEN
+        ):
+            return JSONResponse(
+                {"ok": False, "error": "FinalKit control token required"},
+                status_code=403,
+            )
+    return await call_next(request)
